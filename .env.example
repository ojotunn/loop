# Loop — variaveis de ambiente. Copie para .env (local) ou cole no Railway.

# A carteira do agente. SEM ela o motor so observa (nao assina nada).
# Crie uma carteira nova, mande ETH para ela (taxa 0,0005 + primeiro dev buy + gas)
# e cole a chave privada aqui. Ela nunca sai do servidor.
AGENT_PRIVATE_KEY=

# Token do painel interno (vender e lancar a proxima, pausar, autorizar a queima).
# Se ficar vazio, o servidor gera um e grava em DATA_DIR/admin.token (veja o log).
ADMIN_TOKEN=

# Onde o site mora (usado na descricao do token e nos avisos).
PUBLIC_URL=http://localhost:8437
# Dominio proprio: paginas pedidas por outro host redirecionam para ele (vazio = sem redirect).
CANONICAL_HOST=
PORT=8437
DATA_DIR=data

# O token. Mesmo nome e ticker em todos os loops.
LOOP_NAME=Loop
LOOP_SYMBOL=LOOP
LOOP_LOGO=
LOOP_WEBSITE=
LOOP_TWITTER=
LOOP_TELEGRAM=
CREATOR_TAX_BPS=200

# Regras (horas, porcentagens, ETH).
DEATH_IDLE_HOURS=6
DEATH_DROP_PCT=80
MAX_LIFE_HOURS=48
STILLBORN_HOURS=6
REBIRTH_DELAY_MIN=15
GAS_RESERVE_ETH=0.003
MIN_DEV_BUY_ETH=0.001
FINAL_MARGIN_PCT=2
SELL_SLIPPAGE_PCT=3
WHALE_ETH=0.05
QUIET_HOURS=
TICK_SEC=60

# Voz (opcional): sem chave, frases prontas.
ANTHROPIC_API_KEY=
AGENT_MODEL=claude-sonnet-5
AGENT_VIBE=calm, matter-of-fact, a little poetic about death and rebirth

# X (opcional): as 4 chaves do app do criador.
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=
LINK_X=

# Telegram (opcional): bot + chat. O pedido de autorizacao chega aqui.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
LINK_TELEGRAM=

# Rede (nao mexer, salvo mudanca da pons).
RPC_URL=
PONS_NETWORK=mainnet
